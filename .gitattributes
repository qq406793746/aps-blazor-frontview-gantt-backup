* text=auto

# Enforce stable line endings across platforms.
*.cs          text eol=lf
*.csproj      text eol=lf
*.sln         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.xml         text eol=lf
*.md          text eol=lf
*.ps1         text eol=lf
*.cmd         text eol=crlf
*.bat         text eol=crlf
