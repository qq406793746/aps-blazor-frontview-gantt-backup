@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthService AuthService

<PageTitle>BlazorApp1</PageTitle>

<div class="page @(isSidebarCollapsed ? "sidebar-collapsed" : "")">
    <div class="sidebar">
        <div class="sidebar-content">
            <NavMenu />
        </div>
        <button class="sidebar-toggle" type="button" @onclick="ToggleSidebar" title="切换导航栏" aria-label="切换导航栏">
            <span class="oi @(isSidebarCollapsed ? "oi-chevron-right" : "oi-chevron-left")" aria-hidden="true"></span>
        </button>
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end">
            <a href="#" class="nav-link">
                <span class="oi oi-bell" aria-hidden="true"></span> 通知
            </a>
            <a href="#" class="nav-link">
                <span class="oi oi-person" aria-hidden="true"></span> 管理员
            </a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isSidebarCollapsed;

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    protected override void OnInitialized()
    {
        // 暂时注释掉认证检查，以便测试数据显示
        // if (!AuthService.IsAuthenticated)
        // {
        //     NavigationManager.NavigateTo("/login", forceLoad: true);
        // }
    }
}
