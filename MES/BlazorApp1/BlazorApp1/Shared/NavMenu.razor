@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="/images/logo.png" alt="MES系统" style="height: 60px;" />
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> 首页
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <div class="dropdown" @onclick:stopPropagation>
                <a class="nav-link dropdown-toggle" @onclick='() => ToggleDropdown("dataInterfaceDropdown")' href="#" role="button" id="dataInterfaceDropdown" data-bs-toggle="dropdown" aria-expanded='@(openDropdown == "dataInterfaceDropdown")'>
                    <span class="oi oi-data-transfer-download" aria-hidden="true"></span> 数据对接
                </a>
                <ul class="dropdown-menu @(openDropdown == "dataInterfaceDropdown" ? "show" : "")" aria-labelledby="dataInterfaceDropdown">
                    <li>
                        <NavLink class="dropdown-item" href="project-management">
                            <span class="oi oi-list-rich" aria-hidden="true"></span> 项目管理
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="dropdown-item" href="bom-management">
                            <span class="oi oi-list" aria-hidden="true"></span> BOM管理
                        </NavLink>
                    </li>
                </ul>
            </div>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="process-management">
                <span class="oi oi-list-rich" aria-hidden="true"></span> 工艺管理
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dynamic-scheduling">
                <span class="oi oi-calendar" aria-hidden="true"></span> 动态排产
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <div class="dropdown" @onclick:stopPropagation>
                <a class="nav-link dropdown-toggle" @onclick='() => ToggleDropdown("productionManagementDropdown")' href="#" role="button" id="productionManagementDropdown" data-bs-toggle="dropdown" aria-expanded='@(openDropdown == "productionManagementDropdown")'>
                    <span class="oi oi-document" aria-hidden="true"></span> 生产管理
                </a>
                <ul class="dropdown-menu @(openDropdown == "productionManagementDropdown" ? "show" : "")" aria-labelledby="productionManagementDropdown">
                    <li>
                        <NavLink class="dropdown-item" href="equipment-management">
                            <span class="oi oi-cog" aria-hidden="true"></span> 设备管理
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="dropdown-item" href="manufacturing-info">
                            <span class="oi oi-document" aria-hidden="true"></span> 制造信息管理
                        </NavLink>
                    </li>
                </ul>
            </div>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="material-logistics">
                <span class="oi oi-box" aria-hidden="true"></span> 物料物流管理
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="system-management">
                <span class="oi oi-cog" aria-hidden="true"></span> 系统管理
            </NavLink>
        </div>
        <div class="nav-item px-3 mt-3">
            <button class="btn btn-outline-danger w-100" @onclick="Logout">
                <span class="oi oi-account-logout mr-2"></span> 退出登录
            </button>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? openDropdown = null;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleDropdown(string dropdownId)
    {
        if (openDropdown == dropdownId)
        {
            // 关闭当前下拉菜单
            openDropdown = null;
        }
        else
        {
            // 打开指定的下拉菜单
            openDropdown = dropdownId;
        }
    }

    private void Logout()
    {
        AuthService.Logout();
        ((CustomAuthenticationStateProvider)AuthenticationStateProvider).NotifyAuthenticationStateChanged();
        NavigationManager.NavigateTo("/login");
    }
}
