    {
        public double ScrollLeft { get; set; }
        public double ScrollTop { get; set; }
        public double TimelineWidth { get; set; }
        public double ChartHeight { get; set; }
        public double RowHeight { get; set; }
        public double PxPerHour { get; set; }
    }
