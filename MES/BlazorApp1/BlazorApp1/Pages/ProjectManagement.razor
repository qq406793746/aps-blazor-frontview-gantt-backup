    // 确认删除
    private async Task ConfirmDelete()
    {
        var selectedProjects = allProjects.Where(p => p.IsSelected).ToList();
        if (selectedProjects.Count > 0)
        {
            foreach (var project in selectedProjects)
            {
                // 从数据库删除项目
                await ProjectManagementService.DeleteProjectAsync(project.ProjectCode);
            }
            
            // 从本地列表中删除项目
            allProjects = allProjects.Where(p => !p.IsSelected).ToList();
            
            // 更新分页数据
            totalItems = allProjects.Count;
            totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
            if (currentPage > totalPages)
            {
                currentPage = Math.Max(1, totalPages);
            }
            UpdateCurrentPageData();
            
            // 关闭弹窗
            isDeleteModalOpen = false;
            selectedProjectsCount = 0;
            
            // 重置全选状态
            isAllSelected = false;
        }
    }
    
