    // 文件选择事件处理
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        importStatus = string.Empty;
        importStatusType = string.Empty;
        try
        {
            var file = e.File;
            if (file == null)
            {
                importStatus = "请选择有效的Excel文件";
                importStatusType = "danger";
                return;
            }
            
            // 验证文件类型
            var fileExtension = Path.GetExtension(file.Name).ToLower();
            if (fileExtension != ".xlsx" && fileExtension != ".xls")
            {
                importStatus = "请选择有效的Excel文件(.xlsx或.xls格式)";
                importStatusType = "danger";
                return;
            }
            
            using var stream = new MemoryStream();
            await file.OpenReadStream().CopyToAsync(stream);
            stream.Position = 0;
            
            // 解析Excel文件
            var projects = ParseExcelFile(stream);
            if (projects.Count == 0)
            {
                importStatus = "Excel文件中没有有效数据";
                importStatusType = "danger";
                return;
            }
            
            // 导入到数据库
            var importedCount = await ProjectManagementService.BulkImportProjectsAsync(projects);
            if (importedCount > 0)
            {
                importStatus = $"成功导入 {importedCount} 条项目数据";
                importStatusType = "success";
                // 重新加载数据
                LoadProjectsFromDatabase();
                UpdateCurrentPageData();
            }
            else
            {
                importStatus = "导入失败，请检查Excel文件格式";
                importStatusType = "danger";
            }
        }
        catch (Exception ex)
        {
            importStatus = $"导入失败: {ex.Message}";
            importStatusType = "danger";
            Console.WriteLine(ex);
        }
        finally
        {
        }
    }
    
    // Excel文件解析逻辑
    private List<MESProjectManagement> ParseExcelFile(Stream stream)
    {
        var projects = new List<MESProjectManagement>();
        try
        {
            using var package = new ExcelPackage(stream);
            var worksheet = package.Workbook.Worksheets.First();
            int rowCount = worksheet.Dimension.Rows;
            
            // 从第二行开始读取数据（第一行是标题）
            for (int row = 2; row <= rowCount; row++)
            {
                try
                {
                    var project = new MESProjectManagement();
                    project.ProjectName = worksheet.Cells[row, 1].Text?.Trim();
                    project.ProjectCode = worksheet.Cells[row, 2].Text?.Trim();
                    project.MoldCode = worksheet.Cells[row, 3].Text?.Trim();
                    project.Industry = worksheet.Cells[row, 4].Text?.Trim();
                    project.CustomerInfo = worksheet.Cells[row, 5].Text?.Trim();
                    project.ProductName = worksheet.Cells[row, 6].Text?.Trim();
                    
                    // 解析内部交期
                    if (DateTime.TryParse(worksheet.Cells[row, 7].Text, out DateTime internalLeadTime))
                        project.InternalLeadTime = internalLeadTime;
                    
                    // 解析客户交期
                    if (DateTime.TryParse(worksheet.Cells[row, 8].Text, out DateTime customerLeadTime))
                        project.CustomerLeadTime = customerLeadTime;
                    
                    project.AccuracyLevel = worksheet.Cells[row, 9].Text?.Trim();
                    
                    // 解析优先级
                    if (int.TryParse(worksheet.Cells[row, 10].Text, out int priority))
                        project.Priority = priority;
                    
                    project.ProjectStatus = worksheet.Cells[row, 11].Text?.Trim();
                    
                    // 只有当项目代码不为空时才添加
                    if (!string.IsNullOrEmpty(project.ProjectCode))
                        projects.Add(project);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"解析第 {row} 行数据失败: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"解析Excel文件失败: {ex.Message}");
            throw;
        }
        return projects;
    }
    
    // 新建项目模态框相关变量
    private bool isCreateModalOpen = false;
    private MESProjectManagement newProject = new MESProjectManagement();
    private string createStatus = string.Empty;
    private string createStatusType = string.Empty;
    
    // 打开新建项目模态框
    private void OpenCreateModal()
    {
        newProject = new MESProjectManagement();
        createStatus = string.Empty;
        isCreateModalOpen = true;
    }
    
    // 关闭新建项目模态框
    private void CloseCreateModal()
    {
        isCreateModalOpen = false;
        createStatus = string.Empty;
    }
    
    // 保存新项目
    private async Task SaveNewProject()
    {
        try
        {
            // 验证必填项
            if (string.IsNullOrEmpty(newProject.ProjectName) || 
                string.IsNullOrEmpty(newProject.ProjectCode) || 
                string.IsNullOrEmpty(newProject.MoldCode) || 
                string.IsNullOrEmpty(newProject.ProductName))
            {
                createStatus = "请填写所有必填项（项目名称、项目代码、模具号、产品名称）";
                createStatusType = "danger";
                return;
            }
            
            // 设置默认值
            if (string.IsNullOrEmpty(newProject.ProjectStatus))
            {
                newProject.ProjectStatus = "新建";
            }
            
            // 保存到数据库
            int result = await ProjectManagementService.AddProjectAsync(newProject);
            if (result > 0)
            {
                createStatus = "新项目创建成功";
                createStatusType = "success";
                
                // 重新加载数据
                LoadProjectsFromDatabase();
                UpdateCurrentPageData();
                
                // 延迟关闭模态框，让用户看到成功提示
                await Task.Delay(1500);
                CloseCreateModal();
            }
            else
            {
                createStatus = "新项目创建失败，请稍后重试";
                createStatusType = "danger";
            }
        }
        catch (Exception ex)
        {
            createStatus = $"新建项目失败: {ex.Message}";
            createStatusType = "danger";
            Console.WriteLine(ex);
        }
    }
}

