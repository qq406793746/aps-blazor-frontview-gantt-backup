    // 更新优先级样式类
    private void UpdatePriorityClass(ProjectData project)
    {
        // 根据数值范围设置优先级样式类
        if (project.Priority.HasValue)
        {
            int priorityValue = project.Priority.GetValueOrDefault();
            if (priorityValue >= 1000)
            {
                project.PriorityClass = "badge-danger";
            }
            else if (priorityValue >= 900)
            {
                project.PriorityClass = "badge-danger";
            }
            else if (priorityValue >= 800)
            {
                project.PriorityClass = "badge-warning";
            }
            else if (priorityValue >= 700)
            {
                project.PriorityClass = "badge-warning";
            }
            else if (priorityValue >= 600)
            {
                project.PriorityClass = "badge-secondary";
            }
            else if (priorityValue >= 500)
            {
                project.PriorityClass = "badge-secondary";
            }
            else
            {
                project.PriorityClass = "badge-secondary";
            }
        }
        else
        {
            project.PriorityClass = "badge-secondary";
        }
    }
    
    // 更新项目状态样式类
    private void UpdateProjectStatusClass(ProjectData project)
    {
        switch (project.ProjectStatus)
        {
            case "进行中":
                project.ProjectStatusClass = "badge-success";
                break;
            case "暂停":
                project.ProjectStatusClass = "badge-warning";
                break;
            case "未启动":
                project.ProjectStatusClass = "badge-secondary";
                break;
            case "终止":
                project.ProjectStatusClass = "badge-danger";
                break;
            default:
                project.ProjectStatusClass = "badge-secondary";
                break;
        }
    }
    
    // 项目启动
    private async Task StartProjects()
    {
        var selectedProjects = allProjects.Where(p => p.IsSelected).ToList();
        if (selectedProjects.Count > 0)
        {
            foreach (var project in selectedProjects)
            {
                project.ProjectStatus = "进行中";
                UpdateProjectStatusClass(project);
                
                // 更新到数据库
                var dbProject = new MESProjectManagement
                {
                    ProjectName = project.ProjectName,
                    ProjectCode = project.ProjectCode,
                    MoldCode = project.MoldCode,
                    Industry = project.Industry,
                    CustomerInfo = project.CustomerInfo,
                    ProductName = project.ProductName,
                    InternalLeadTime = project.InternalDeadline,
                    CustomerLeadTime = project.CustomerDeadline,
                    Priority = project.Priority,
                    ProjectStatus = project.ProjectStatus,
                    AccuracyLevel = project.Accuracy
                };
                await ProjectManagementService.UpdateProjectAsync(dbProject, project.ProjectCode);
            }
            UpdateCurrentPageData();
        }
        else
        {
            if (JSRuntime != null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "请选择项目");
            }
        }
    }

