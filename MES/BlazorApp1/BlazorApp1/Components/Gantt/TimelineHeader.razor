@using System.Globalization

<div class="rg-timeline" style="width:@TotalWidthpx;">
    <div class="rg-timeline-row">
        @foreach (var day in Days)
        {
            <div class="rg-timeline-cell rg-day-cell @day.CssClass" style="width:@day.Widthpx;">
                @day.Label
            </div>
        }
    </div>
    <div class="rg-timeline-row">
        @foreach (var hour in Hours)
        {
            <div class="rg-timeline-cell rg-hour-cell @hour.CssClass" style="width:@hour.Widthpx;">
                @hour.Label
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DateTime From { get; set; }
    [Parameter] public DateTime To { get; set; }
    [Parameter] public double PxPerMinute { get; set; } = 2;

    private double TotalWidth => Math.Max(200, (To - From).TotalMinutes * PxPerMinute);
    private string TotalWidthpx => $"{TotalWidth}px";

    private IReadOnlyList<Cell> Days { get; set; } = Array.Empty<Cell>();
    private IReadOnlyList<Cell> Hours { get; set; } = Array.Empty<Cell>();

    protected override void OnParametersSet()
    {
        BuildCells();
    }

    private void BuildCells()
    {
        var days = new List<Cell>();
        var hours = new List<Cell>();
        var dayCursor = From;
        while (dayCursor < To)
        {
            var nextDay = dayCursor.Date.AddDays(1);
            if (nextDay <= dayCursor)
            {
                nextDay = dayCursor.AddDays(1);
            }
            var segmentEnd = nextDay < To ? nextDay : To;
            var width = (segmentEnd - dayCursor).TotalMinutes * PxPerMinute;
            days.Add(new Cell
            {
                Label = $"{dayCursor:MM-dd} {GetWeekLabel(dayCursor.DayOfWeek)}",
                Width = width,
                CssClass = GetDayCss(dayCursor.DayOfWeek)
            });
            dayCursor = segmentEnd;
        }

        const int hourStep = 2;
        var hourCursor = From;
        var hourIndex = 0;
        var hourCellWidth = hourStep * 60 * PxPerMinute;
        var hourLabelStride = Math.Max(1, (int)Math.Ceiling(30d / Math.Max(1d, hourCellWidth)));
        while (hourCursor < To)
        {
            var next = hourCursor.AddHours(hourStep);
            if (next > To)
            {
                next = To;
            }
            var width = (next - hourCursor).TotalMinutes * PxPerMinute;
            var showLabel = hourIndex % hourLabelStride == 0;
            var label = "";
            if (showLabel)
            {
                label = width >= 22 ? hourCursor.ToString("HH:mm", CultureInfo.InvariantCulture) : hourCursor.ToString("HH", CultureInfo.InvariantCulture);
            }
            hours.Add(new Cell
            {
                Label = label,
                Width = width,
                CssClass = ""
            });
            hourCursor = next;
            hourIndex++;
        }

        Days = days;
        Hours = hours;
    }

    private static string GetWeekLabel(DayOfWeek dayOfWeek)
        => dayOfWeek switch
        {
            DayOfWeek.Monday => "星期一",
            DayOfWeek.Tuesday => "星期二",
            DayOfWeek.Wednesday => "星期三",
            DayOfWeek.Thursday => "星期四",
            DayOfWeek.Friday => "星期五",
            DayOfWeek.Saturday => "星期六",
            DayOfWeek.Sunday => "星期日",
            _ => string.Empty
        };

    private static string GetDayCss(DayOfWeek dayOfWeek)
        => dayOfWeek switch
        {
            DayOfWeek.Saturday => "rg-day-sat",
            DayOfWeek.Sunday => "rg-day-sun",
            _ => "rg-day-weekday"
        };

    private sealed class Cell
    {
        public string Label { get; set; } = "";
        public double Width { get; set; }
        public string Widthpx => $"{Width}px";
        public string CssClass { get; set; } = "";
    }
}
